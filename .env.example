# ==============================================================================
# AgentShield Environment Configuration
# ==============================================================================

# Database URL (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./agentshield.db
ENVIRONMENT=development
PROJECT_NAME=AgentShield
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# NVIDIA NIM Inference (Hosted API)
# ------------------------------------------------------------------------------
# Get your API key from: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ------------------------------------------------------------------------------
# Payment Provider Selection ("mock" or "razorpay")
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=mock

# Razorpay Sandbox / Test Mode Credentials (when PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
